{
  "name": "old-norwegian-dictionary-next",
  "description": "Next.js implementation of Old Norwegian Dictionary",
  "version": "0.1.0",
  "private": true,
  "repository": "https://github.com/stscoundrel/old-norwegian-dictionary-next.git",
  "author": "stscoundrel <silvennoinen.sampo@gmail.com>",
  "licenses": [
    {
      "type": "MIT",
      "url": "http://opensource.org/licenses/MIT"
    }
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "prettier src tests --check",
    "fix": "prettier src tests --write",
    "jest": "jest --verbose --passWithNoTests",
    "test:unit": "npm run jest",
    "test:integration": "cypress run --env env=test --spec 'tests/integration/tests/**/*'",
    "test:coverage": "jest --coverage tests src/components --coverageThreshold='{\"global\":{\"statements\":\"90\", \"functions\":\"80\", \"branches\":\"80\", \"lines\":\"90\"}}'"
  },
  "dependencies": {
    "abbreviatrix": "^1.0.8",
    "markari": "^1.0.7",
    "next": "^16.3.4",
    "next-pwa": "^5.6.0",
    "old-norse-alphabet": "^1.2.5",
    "old-norse-alphabet-sort": "^1.1.13",
    "old-norwegian-dictionary": "^1.0.4",
    "old-norwegian-dictionary-abbreviations": "^1.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reset-css": "^5.0.2",
    "riimut": "^0.9.1",
    "sass": "^1.104.0",
    "scandinavian-dictionary-crosslinker": "^0.7.0",
    "sitemap": "^7.1.1",
    "slugify": "^1.6.9",
    "teljari": "^1.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.31",
    "cypress": "^15.21.1",
    "identity-obj-proxy": "^3.0.0",
    "jafningjar": "^1.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "node-mocks-http": "^1.18.1",
    "prettier": "^3.9.9",
    "react-test-renderer": "^18.3.1",
    "typescript": "^7.0.2"
  }
}
